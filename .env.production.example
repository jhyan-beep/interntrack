APP_DOMAIN=interntrack.example.com
POSTGRES_PASSWORD=replace-with-a-url-safe-random-value
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-32-characters
SESSION_COOKIE_NAME=interntrack_session
SESSION_EXPIRE_HOURS=168
JWT_ISSUER=interntrack
JWT_AUDIENCE=interntrack-web
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_PER_IP=20
AUTH_RATE_LIMIT_PER_IDENTITY=10
LOG_LEVEL=INFO
LOG_FORMAT=json
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM=InternTrack <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_STARTTLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_WORKER_POLL_SECONDS=5
REMINDER_SCAN_INTERVAL_SECONDS=300
BACKUP_RETENTION_DAYS=7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=20
