{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "desktop-autostart",
  "description": "Allow the packaged loopback UI to manage Windows sign-in startup",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8765/*"]
  },
  "platforms": ["windows"],
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
