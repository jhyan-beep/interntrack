APP_NAME=InternTrack
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://interntrack:interntrack@db:5432/interntrack
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,test
SECRET_KEY=replace-with-a-long-random-value-before-deploying
